<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Splash do Android 12+. Sem isso, o sistema põe o ícone num círculo
      branco. Aqui o fundo do ícone tem a mesma cor da tela, então aparece só
      o quadrado azul-noite do morceguinho, sem borda.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
